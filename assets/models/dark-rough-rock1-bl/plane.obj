# OBJ file format
mtllib plane.mtl

# Vertices (A flat plane lying on the XY axis facing Z)
v -1.0 -1.0 0.0
v  1.0 -1.0 0.0
v  1.0  1.0 0.0
v -1.0  1.0 0.0

# Texture Coordinates (UVs)
vt 0.0 0.0
vt 1.0 0.0
vt 1.0 1.0
vt 0.0 1.0

# Normals (Pointing strictly up towards the camera in +Z)
vn 0.0 0.0 1.0

# Faces (Two triangles making a quad)
usemtl RockMaterial
f 1/1/1 2/2/1 3/3/1
f 1/1/1 3/3/1 4/4/1
